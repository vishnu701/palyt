# Copy to .env and fill in. deploy/deploy.sh uploads .env to the VM; it is never committed.
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Set once DNS exists, e.g. demo.palyt.in — Caddy then fetches a real certificate.
SITE_ADDRESS=:443
# Interpreter LLM: "sarvam" (India-hosted, ~250 ms) or unset for Claude (~2 s)
LLM_PROVIDER=sarvam
SARVAM_LLM_MODEL=sarvam-105b-conversations
